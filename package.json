{
  "name": "orca-inp",
  "displayName": "ORCA Input Files (.inp)",
  "description": "Syntax highlighting, diagnostics and autocompletion for ORCA quantum chemistry input files (.inp)",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "alestoman5",
  "repository": {
    "type": "git",
    "url": "https://github.com/alestoman5/Orbital"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.6.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "orca",
    "quantum chemistry",
    "computational chemistry",
    "dft",
    "inp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:orca-inp",
    "workspaceContains:**/*.out"
  ],
  "contributes": {
    "commands": [
      { "command": "orcaInp.displaceAlongImaginaryMode", "title": "Displace Geometry Along Imaginary Mode", "category": "ORCA", "icon": "$(debug-step-over)" },
      { "command": "orcaInp.createIrcInput", "title": "Create IRC Input from TS", "category": "ORCA" },
      { "command": "orcaInp.exportMolden", "title": "Export Molden (Normal Modes, for Wigner)", "category": "ORCA", "icon": "$(export)" },
      { "command": "orcaInp.showWignerReport", "title": "Wigner Sampling Readiness Report", "category": "ORCA" },
      { "command": "orcaInp.createBasisVariants", "title": "Create Basis-Set Variants of This Input", "category": "ORCA" },
      { "command": "orcaInp.compareGeometries", "title": "Compare Final Geometries (Bonds/Angles)", "category": "ORCA" },
      { "command": "orcaInp.exportPyneapples", "title": "Export Excitations for PyNEAppLES", "category": "ORCA" },
      { "command": "orcaInp.boltzmannWeights", "title": "Boltzmann Weights of Conformers", "category": "ORCA" },
      { "command": "orcaInp.previewSpectrum", "title": "Preview Absorption Spectrum", "category": "ORCA", "icon": "$(graph-line)" },
      { "command": "orcaInp.runActions", "title": "Actions for This Run", "category": "ORCA" },
      { "command": "orcaInp.runs.refresh", "title": "Refresh", "category": "ORCA", "icon": "$(refresh)" },
      { "command": "orcaInp.runs.toggleProblemsOnly", "title": "Show Only Problem Runs", "category": "ORCA", "icon": "$(filter)" },
      { "command": "orcaInp.runs.toggleProblemsOnlyOff", "title": "Show All Runs", "category": "ORCA", "icon": "$(filter-filled)" }
    ],
    "views": {
      "explorer": [
        { "id": "orcaRuns", "name": "ORCA Runs", "when": "workspaceFolderCount > 0" }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "orcaInp.runs.refresh", "when": "false" },
        { "command": "orcaInp.runs.toggleProblemsOnly", "when": "false" },
        { "command": "orcaInp.runs.toggleProblemsOnlyOff", "when": "false" }
      ],
      "view/title": [
        { "command": "orcaInp.runs.toggleProblemsOnly", "when": "view == orcaRuns && !orcaInp.runs.problemsOnly", "group": "navigation" },
        { "command": "orcaInp.runs.toggleProblemsOnlyOff", "when": "view == orcaRuns && orcaInp.runs.problemsOnly", "group": "navigation" },
        { "command": "orcaInp.runs.refresh", "when": "view == orcaRuns", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "orcaInp.displaceAlongImaginaryMode", "when": "view == orcaRuns && viewItem == orcaRun.saddle", "group": "inline" },
        { "command": "orcaInp.displaceAlongImaginaryMode", "when": "view == orcaRuns && viewItem == orcaRun.saddle", "group": "1_orca" },
        { "command": "orcaInp.createIrcInput", "when": "view == orcaRuns && viewItem =~ /orcaRun\\.ts/", "group": "1_orca" },
        { "command": "orcaInp.exportMolden", "when": "view == orcaRuns && viewItem =~ /orcaRun\\.(ok|saddle)/", "group": "1_orca" },
        { "command": "orcaInp.showWignerReport", "when": "view == orcaRuns && viewItem =~ /orcaRun\\.(ok|saddle)/", "group": "1_orca" },
        { "command": "orcaInp.previewSpectrum", "when": "view == orcaRuns", "group": "2_orca" }
      ],
      "explorer/context": [
        { "command": "orcaInp.exportMolden", "when": "resourceExtname == .out", "group": "7_orca" },
        { "command": "orcaInp.showWignerReport", "when": "resourceExtname == .out", "group": "7_orca" },
        { "command": "orcaInp.displaceAlongImaginaryMode", "when": "resourceExtname == .out", "group": "7_orca" },
        { "command": "orcaInp.previewSpectrum", "when": "resourceExtname == .out || explorerResourceIsFolder", "group": "7_orca" },
        { "command": "orcaInp.boltzmannWeights", "when": "resourceExtname == .out && listMultiSelection", "group": "7_orca" },
        { "command": "orcaInp.createBasisVariants", "when": "resourceExtname == .inp", "group": "7_orca" },
        { "command": "orcaInp.compareGeometries", "when": "explorerResourceIsFolder", "group": "7_orca" },
        { "command": "orcaInp.exportPyneapples", "when": "explorerResourceIsFolder", "group": "7_orca" }
      ],
      "editor/title": [
        { "command": "orcaInp.previewSpectrum", "when": "resourceExtname == .out", "group": "navigation" }
      ]
    },
    "languages": [
      {
        "id": "orca-inp",
        "aliases": [
          "ORCA Input",
          "orca-inp"
        ],
        "extensions": [
          ".inp"
        ],
        "filenamePatterns": [
          "*.inp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/orca-icon.svg",
          "dark": "./images/orca-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "orca-inp",
        "scopeName": "source.orca-inp",
        "path": "./syntaxes/orca.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "orca-inp",
        "path": "./snippets/orca.json"
      }
    ],
    "configuration": {
      "title": "ORCA Input",
      "properties": {
        "orcaInp.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable live syntax/structure diagnostics for .inp files."
        },
        "orcaInp.diagnostics.unknownKeywordSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "Severity used when a simple-input (!) keyword is not recognized."
        },
        "orcaInp.diagnostics.semantic": {
          "type": "boolean",
          "default": true,
          "description": "Chemistry-aware checks: charge/multiplicity parity, atom order, conflicting runtypes, OptTS without Hessian, %tddft without NRoots, several basis sets."
        },
        "orcaInp.diagnostics.memoryCheck": {
          "type": "boolean",
          "default": false,
          "description": "Warn when %maxcore x nprocs exceeds 75 % of this machine's memory. Off by default, since inputs are often written locally but run on a cluster."
        },
        "orcaInp.referenceAtomOrder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Expected element order of the coordinate block, e.g. `C O O H H`. Leave empty to disable. Downstream scripts (Wigner sampling, MD, ML descriptors) usually rely on a fixed atom order. Best set per workspace."
        },
        "orcaInp.ts.autoPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Offer to displace the geometry when an optimization finishes at a saddle point (and to create an IRC input after a clean TS search)."
        },
        "orcaInp.ts.maxDisplacement": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Displacement along the imaginary mode, in Å, of the atom that moves most."
        },
        "orcaInp.ts.imagThreshold": {
          "type": "number",
          "default": -20,
          "maximum": 0,
          "description": "Frequencies below this value (cm⁻¹) count as imaginary modes; between it and 0 they are reported as likely numerical noise."
        },
        "orcaInp.ts.useMoread": {
          "type": "boolean",
          "default": false,
          "description": "Start the displaced job from the previous orbitals (adds MORead + %moinp \"job.gbw\")."
        },
        "orcaInp.wigner.temperature": {
          "type": "number",
          "default": 300,
          "description": "Temperature (K) used in the Wigner readiness report."
        },
        "orcaInp.wigner.softModeThreshold": {
          "type": "number",
          "default": 200,
          "description": "Modes below this wavenumber (cm⁻¹) are flagged as soft / possibly anharmonic in the Wigner report."
        },
        "orcaInp.variants.basisSets": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["aug-cc-pVDZ", "def2-SVPD", "ma-def2-SVP", "def2-SVP"],
          "description": "Basis sets offered by 'Create Basis-Set Variants'."
        },
        "orcaInp.watchedCoordinates": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Internal coordinates for 'Compare Final Geometries', as `label: i-j[-k[-l]]` with 1-based atom indices, e.g. `O-O: 2-3`, `C-O-O: 1-2-3`. A `.orca-watch.json` array in the folder takes precedence."
        },
        "orcaInp.pyneapples.pattern": {
          "type": "string",
          "default": "**/*.out",
          "description": "Glob (relative to the chosen folder) selecting the per-geometry outputs for the PyNEAppLES export."
        },
        "orcaInp.spectrum.singleGeometryBandwidth": {
          "type": "number",
          "default": 0.2,
          "description": "Gaussian width (eV) used when previewing the spectrum of a single geometry."
        },
        "orcaInp.boltzmann.temperature": {
          "type": "number",
          "default": 298.15,
          "description": "Temperature (K) for conformer Boltzmann weights."
        },
        "orcaInp.runs.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git}/**",
          "description": "Glob of folders ignored when looking for .out files."
        },
        "orcaInp.runs.maxFiles": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of .out files listed in the ORCA Runs view."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
