{
  "Single point energy": {
    "prefix": "orca-sp",
    "body": [
      "# ${1:description}",
      "! ${2:B3LYP} ${3:def2-TZVP} ${4:D4}",
      "%pal nprocs ${5:4} end",
      "%maxcore ${6:2000}",
      "* xyz ${7:0} ${8:1}",
      "${9:O   0.000000   0.000000   0.000000}",
      "*"
    ],
    "description": "Minimal single point energy calculation"
  },

  "Geometry optimization + frequencies": {
    "prefix": "orca-optfreq",
    "body": [
      "# ${1:description}",
      "! ${2:B3LYP} ${3:def2-TZVP} ${4:D4} RIJCOSX def2/J Opt Freq",
      "%pal nprocs ${5:4} end",
      "%maxcore ${6:2000}",
      "* xyz ${7:0} ${8:1}",
      "${9:O   0.000000   0.000000   0.000000}",
      "*"
    ],
    "description": "Geometry optimization followed by frequency calculation"
  },

  "TD-DFT UV/Vis": {
    "prefix": "orca-tddft",
    "body": [
      "# ${1:UV/Vis via TD-DFT}",
      "! ${2:wB97X-D4} ${3:def2-TZVP} RIJCOSX def2/J",
      "%pal nprocs ${4:4} end",
      "%maxcore ${5:2000}",
      "%tddft",
      "  nroots ${6:10}",
      "end",
      "* xyzfile ${7:0} ${8:1} ${9:molecule.xyz}"
    ],
    "description": "TD-DFT excited states / UV-Vis spectrum"
  },

  "Transition state (OptTS + Freq)": {
    "prefix": "orca-optts",
    "body": [
      "# ${1:transition state search}",
      "! ${2:B3LYP} ${3:def2-TZVP} ${4:D4} OptTS Freq",
      "%pal nprocs ${5:4} end",
      "%maxcore ${6:2000}",
      "%geom",
      "  Calc_Hess true",
      "end",
      "* xyz ${7:0} ${8:1}",
      "${9:# atoms here}",
      "*"
    ],
    "description": "Transition state optimization with analytic Hessian at start"
  },

  "%pal block": {
    "prefix": "orca-pal",
    "body": "%pal nprocs ${1:4} end",
    "description": "Parallelization block"
  },

  "%geom constraints block": {
    "prefix": "orca-constraints",
    "body": [
      "%geom",
      "  Constraints",
      "    { B ${1:0} ${2:1} }",
      "  end",
      "end"
    ],
    "description": "Constrain a bond between two atom indices"
  },

  "Implicit solvation (CPCM)": {
    "prefix": "orca-cpcm",
    "body": "! ${1:B3LYP} ${2:def2-TZVP} CPCM(${3:water})",
    "description": "Add implicit solvation via CPCM"
  },

  "Tight Opt + Freq (minimum for Wigner sampling)": {
    "prefix": "orca-optfreq-tight",
    "body": [
      "# ${1:tight minimum for Wigner sampling}",
      "! ${2:PBE} ${3:aug-cc-pVDZ} TightOpt Freq TightSCF",
      "%pal nprocs ${4:4} end",
      "%maxcore ${5:2000}",
      "* xyzfile ${6:0} ${7:1} ${8:start.xyz}"
    ],
    "description": "Tight optimization + frequencies; check for 0 imaginary modes before Wigner sampling"
  },

  "Energy + gradient (forces for external MD)": {
    "prefix": "orca-engrad",
    "body": [
      "# ${1:forces for an external MD driver (e.g. ABIN)}",
      "! ${2:PBE} ${3:aug-cc-pVDZ} EnGrad TightSCF NoAutoStart MiniPrint",
      "* xyzfile ${4:0} ${5:1} ${6:geom.xyz}"
    ],
    "description": "Single-point energy and gradient, minimal printout"
  },

  "EOM-CCSD excited states": {
    "prefix": "orca-eom-ccsd",
    "body": [
      "# ${1:EOM-CCSD benchmark of excitations}",
      "! EOM-CCSD ${2:aug-cc-pVDZ} ${3:aug-cc-pVDZ/C} TightSCF",
      "%maxcore ${4:4000}",
      "%mdci",
      "  NRoots ${5:2}",
      "end",
      "* xyzfile ${6:0} ${7:1} ${8:geom.xyz}"
    ],
    "description": "EOM-CCSD excitation energies and oscillator strengths"
  },

  "bt-PNO-STEOM-CCSD excited states": {
    "prefix": "orca-steom",
    "body": [
      "# ${1:STEOM-CCSD excitations}",
      "! bt-PNO-STEOM-CCSD ${2:def2-TZVP} ${3:def2-TZVP/C} TightSCF",
      "%maxcore ${4:4000}",
      "%mdci",
      "  NRoots ${5:5}",
      "end",
      "* xyzfile ${6:0} ${7:1} ${8:geom.xyz}"
    ],
    "description": "Back-transformed PNO STEOM-CCSD excited states"
  },

  "DLPNO-CCSD(T) single point (T1/D1 diagnostics)": {
    "prefix": "orca-dlpno",
    "body": [
      "# ${1:reference energy + T1/D1 multireference diagnostics}",
      "! DLPNO-CCSD(T) ${2:cc-pVTZ} ${3:cc-pVTZ/C} TightSCF TightPNO",
      "%maxcore ${4:4000}",
      "* xyzfile ${5:0} ${6:1} ${7:geom.xyz}"
    ],
    "description": "DLPNO-CCSD(T) single point; check T1 > 0.02 / D1 > 0.05 in the output"
  },

  "IRC from a transition state": {
    "prefix": "orca-irc",
    "body": [
      "# ${1:IRC from the TS}",
      "! ${2:B3LYP} ${3:def2-TZVP} ${4:D4} IRC",
      "%irc",
      "  InitHess read",
      "  Hess_Filename \"${5:ts.hess}\"",
      "  MaxIter ${6:100}",
      "end",
      "* xyzfile ${7:0} ${8:1} ${9:ts.xyz}"
    ],
    "description": "Intrinsic reaction coordinate, reusing the TS Hessian"
  },

  "NEB-TS search": {
    "prefix": "orca-nebts",
    "body": [
      "# ${1:NEB-TS between reactant and product}",
      "! ${2:B3LYP} ${3:def2-SVP} ${4:D4} NEB-TS Freq",
      "%neb",
      "  NEB_End_XYZFile \"${5:product.xyz}\"",
      "  NImages ${6:8}",
      "end",
      "* xyzfile ${7:0} ${8:1} ${9:reactant.xyz}"
    ],
    "description": "Nudged elastic band with climbing-image TS refinement"
  },

  "Relaxed surface scan": {
    "prefix": "orca-scan",
    "body": [
      "# ${1:relaxed scan of a bond}",
      "! ${2:PBE} ${3:def2-SVP} Opt",
      "%geom",
      "  Scan",
      "    B ${4:1} ${5:2} = ${6:1.3}, ${7:2.3}, ${8:11}",
      "  end",
      "end",
      "* xyzfile ${9:0} ${10:1} ${11:geom.xyz}"
    ],
    "description": "Relaxed scan along a bond (0-based atom indices, Å)"
  },

  "GOAT conformer search": {
    "prefix": "orca-goat",
    "body": [
      "# ${1:conformer search}",
      "! XTB GOAT ${2:ALPB(water)}",
      "%pal nprocs ${3:8} end",
      "* xyzfile ${4:0} ${5:1} ${6:molecule.xyz}"
    ],
    "description": "Global conformer search with GFN2-xTB"
  },

  "Restart from orbitals (MORead)": {
    "prefix": "orca-moread",
    "body": [
      "! MORead",
      "%moinp \"${1:previous.gbw}\""
    ],
    "description": "Start the SCF from the orbitals of a previous job"
  }
}
